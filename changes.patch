+    const open = cast(t, make(), {}, {}).damage;
+    const def = cast(t, make(), {}, { def: 300 }).damage;
+    assert.ok(def < open * 0.6 && def > open * 0.4, `防禦 300 應該約減半：${def} / ${open}`);
+  }
+});
+
+test('穿甲：法術與攻擊都無視一半防禦', t => {
